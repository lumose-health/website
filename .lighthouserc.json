{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": ["http://localhost/index.html", "http://localhost/v2.html"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/index\\.html$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:performance": ["warn", { "minScore": 0.5, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/v2\\.html$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
            "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
            "categories:performance": ["error", { "minScore": 0.7, "aggregationMethod": "median" }]
          }
        },
        {
          "matchingUrlPattern": "/v2\\.html$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8, "aggregationMethod": "median" }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200, "aggregationMethod": "median" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05, "aggregationMethod": "median" }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
